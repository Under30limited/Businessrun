# ================================================================
# BusinessRun API — Environment Variables
# ================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================================

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Frontend URL (used for CORS whitelist) ───────────────────────
FRONTEND_URL=https://thebusinessrun.com

# ── Gemini AI ────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY='AIzaSyCPiNqJoE2WM5_lxKEOaXkxlXv3FHDwNbo'

# ── Firebase Admin SDK ───────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → copy values from the downloaded JSON
FIREBASE_PROJECT_ID="businessrun-date"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@businessrun-date.iam.gserviceaccount.com"
# Firebase Web API Key — found in Firebase Console → Project Settings → General
# This is the public Web API key (not the service account private key)
FIREBASE_WEB_API_KEY='1:963582932899:web:30297801ea00afe5820c16'

